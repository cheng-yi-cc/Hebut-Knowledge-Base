  45   1        WriteOneChar(0x44); // 启动温度转换
  46   1        delay_18B20(100); //至少750ms
  47   1        Init_DS18B20();
  48   1        WriteOneChar(0xCC); //跳过读序号列号的操作
  49   1        WriteOneChar(0xBE); //读取温度寄存器
  50   1        a=ReadOneChar();
  51   1        b=ReadOneChar();
  52   1        if((b&0xf8)==0xf8) //位为1 时温度是负
  53   1        {
  54   2          b=~b;
